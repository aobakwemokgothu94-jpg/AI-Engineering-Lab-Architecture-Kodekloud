## Implementation

The application is implemented in `haiku_generator.py`.

```python
import os
from openai import OpenAI

client = OpenAI(
    api_key=os.environ.get("OPENAI_API_KEY"),
    base_url=os.environ.get("OPENAI_API_BASE")
)


def generate_haiku(topic: str) -> str:
    parameterized_prompt = f"""
Write a haiku about {topic}.

Strictly follow the traditional 5-7-5 syllable structure:
- First line: exactly 5 syllables.
- Second line: exactly 7 syllables.
- Third line: exactly 5 syllables.

Return only the three lines of the haiku.
Do not include a title, explanation, or syllable counts.
"""

    response = client.chat.completions.create(
        model="gpt-5.6-luna",
        messages=[
            {"role": "user", "content": parameterized_prompt}
        ],
        max_tokens=200,
        temperature=0.0
    )

    return response.choices[0].message.content.strip()


topic = "sky"
response = generate_haiku(topic)

print(response)
```

