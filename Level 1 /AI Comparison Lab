Python
import os
from openai import OpenAI

def compare(item1: str, item2: str) -> str:
    """
    Compares two given items specifically regarding their chipset using the gpt-5.6-luna model.
    """
    api_key = os.environ.get('OPENAI_API_KEY')
    base_url = os.environ.get('OPENAI_API_BASE')
    
    client = OpenAI(
        api_key=api_key,
        base_url=base_url
    )
    
    prompt = (
        f"Compare {item1} and {item2} in terms of only the chip used. "
        "Provide your response in one word only."
    )
    
    completion = client.chat.completions.create(
        model="gpt-5.6-luna",
        messages=[{"role": "user", "content": prompt}],
        max_tokens=100,
        temperature=0.5
    )
    
    content = completion.choices[0].message.content
    response = content.strip() if content else ""
    return response

if __name__ == "__main__":
    response = compare("iphone 13", "iphone 17")
    print(response)
