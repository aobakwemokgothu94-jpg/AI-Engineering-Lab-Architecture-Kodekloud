import os
from openai import OpenAI

# Initialize OpenAI Client using credentials from /root/.bash_profile
api_key = os.environ.get('OPENAI_API_KEY')
base_url = os.environ.get('OPENAI_API_BASE')

client = OpenAI(
    api_key=api_key,
    base_url=base_url
)

def generate_press_release(brief_path: str, output_path: str):
    """Read product brief and generate a comprehensive press release using OpenAI API."""
    full_brief_path = os.path.join('/root/openaiproject', brief_path)
    full_output_path = os.path.join('/root/openaiproject', output_path)
    
    with open(full_brief_path, 'r') as f:
        brief_content = f.read()
        
    response = client.chat.completions.create(
        model="gpt-5.6-luna",
        messages=[
            {
                "role": "system",
                "content": "You are an expert PR specialist. Based on the provided product brief, write a comprehensive, exciting, professional press release of approximately 150 words with a compelling headline, dateline, body paragraphs, and boilerplate."
            },
            {
                "role": "user",
                "content": brief_content
            }
        ],
        temperature=0.7,
        max_tokens=1500
    )
    
    message = response.choices[0].message
    press_release_text = getattr(message, 'content', None) or ""
    
    os.makedirs(os.path.dirname(full_output_path), exist_ok=True)
    with open(full_output_path, 'w') as f:
        f.write(press_release_text)

def analyze_press_release(pr_path: str) -> str:
    """Read the press release, analyze it as a cynical journalist, and return raw JSON."""
    full_pr_path = os.path.join('/root/openaiproject', pr_path)
    
    with open(full_pr_path, 'r') as f:
        pr_content = f.read()
        
    response = client.chat.completions.create(
        model="gpt-5.6-luna",
        messages=[
            {
                "role": "system",
                "content": "You are a cynical, skeptical tech journalist. Read the following press release. Identify the 'Top 3 Toughest Questions' a journalist would ask about this product. Return a JSON object with a single key tough_questions, which is a list of strings. Return ONLY the raw JSON object, with no additional text, explanations, or Markdown code fences."
            },
            {
                "role": "user",
                "content": pr_content
            }
        ],
        temperature=0.5,
        max_tokens=1500
    )
    
    message = response.choices[0].message
    content = getattr(message, 'content', None) or ""
    return content.strip()

if __name__ == "__main__":
    os.chdir("/root/openaiproject")
    
    # Step 1: Generate PR Document
    generate_press_release('product_brief.txt', 'press_release.txt')
    
    # Step 2: Analyze PR Document & Output Raw JSON
    result_json = analyze_press_release('press_release.txt')
    print(result_json)
