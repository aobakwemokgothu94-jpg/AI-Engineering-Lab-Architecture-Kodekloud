Code Implementation (config_builder.py)
Python
import os
import yaml
from openai import OpenAI

# Initialize OpenAI Client using credentials from /root/.bash_profile
api_key = os.environ.get('OPENAI_API_KEY')
base_url = os.environ.get('OPENAI_API_BASE')

client = OpenAI(
    api_key=api_key,
    base_url=base_url
)

def generate_yaml(prompt: str, output_path: str):
    """Generates a Kubernetes Deployment YAML using the OpenAI API and saves it."""
    response = client.chat.completions.create(
        model="gpt-5.6-luna",
        messages=[
            {
                "role": "user",
                "content": f"{prompt}. Generate a valid Kubernetes Deployment YAML file for deployment for nginx. Respond ONLY with raw YAML."
            }
        ],
        temperature=0.2,
        max_tokens=500
    )
    
    message = response.choices[0].message
    yaml_text = getattr(message, 'content', None) or ""
    
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    with open(output_path, 'w') as f:
        f.write(yaml_text)

def validate_yaml(file_path: str) -> bool:
    """Reads the YAML file and checks whether it is syntactically valid."""
    try:
        with open(file_path, 'r') as f:
            yaml.safe_load(f)
        return True
    except Exception:
        return False

if __name__ == "__main__":
    output_file = "/root/openaiproject/deployment.yaml"
    prompt_text = "create a deployment for nginx"
    
    # Stage 1: Generate YAML Configuration
    generate_yaml(prompt_text, output_file)
    
    # Stage 2: Validate YAML Syntax & Output Result
    if validate_yaml(output_file):
        print("VALID")
    else:
        print("INVALID")
